pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/prakashsah2007/jenkins.git'
            } 
        }
         tools {
        maven 'Maven-3.9'   // Step 2 mein jo naam diya tha, exactly wahi
    } 
stage('Build') {
            steps {
                sh 'mvn clean install -DskipTests'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('Security Scan') {
            steps {
                sh 'mvn org.owasp:dependency-check-maven:check'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'docker build -t demo-app:latest .'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker run -d -p 8081:8080 demo-app:latest'
            }
        }
    }
    post {
        success { echo 'Pipeline pass ho gayi — build deployed.' }
        failure { echo 'Pipeline fail — check logs.' }
    }
}
